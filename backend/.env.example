# — Runtime ————————————————————————————————————————————
NODE_ENV=development
PORT=5000

# — MongoDB ————————————————————————————————————————————
# The single database used by /api/v1 (M0 Atlas free tier is fine).
MONGO_URL=mongodb://127.0.0.1:27017/nova

# — Secrets (min 32 chars each; REQUIRED in production) —
ACCESS_TOKEN_SECRET=dev-access-secret-change-me-0123456789abcdef
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-0123456789abcdef

# Access JWT lifetime in SECONDS (900 = 15 min); refresh cookie/session lives 30 days.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# — Cookies ————————————————————————————————————————————
# In production (https) this should be true; dev over http needs false.
COOKIE_SECURE=false

# — Served links inside emails ————————————————————————
# The Next app (web/) that receives /auth#reset and /auth#verify
WEB_APP_URL=http://localhost:3000

# Origins besides WEB_APP_URL that may make logged-in writes (comma-separated), e.g. https://www.example.com
ALLOWED_ORIGINS=

# — Email ——————————————————————————————————————————————
# Without RESEND_API_KEY the console transport is used (codes are
# printed to the log and kept in an in-memory outbox).
RESEND_API_KEY=
EMAIL_FROM="NOVA <onboarding@resend.dev>"

# — Rate limiting ——————————————————————————————————————
# With Upstash env vars present the Redis (REST) store is used,
# otherwise the in-memory store. Empty = memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 1 only for automated test runs.
RATE_LIMIT_DISABLED=

# — Publishing (phase 3) ————————————————————————————
# REVALIDATE_SECRET: shared with web’s /api/revalidate; unset = no webhook.
# CRON_SECRET: Vercel Cron sends it as a Bearer token to /api/v1/internal/publish-due.
REVALIDATE_SECRET=
CRON_SECRET=
# Image uploads (signed direct upload to Cloudinary); unset = /admin/media/sign answers 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# — First bootstrap admin (npm run seed) ———————————
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# — Observability ——————————————————————————————————————
LOG_LEVEL=info
# Sentry error reporting (5xx only); unset = off.
SENTRY_DSN=
