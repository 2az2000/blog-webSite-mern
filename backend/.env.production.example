# Production values for the API project on Vercel. This file is a CHECKLIST, not a place for secrets:
# put the real values in Vercel → Project → Settings → Environment Variables (Production), never here.
# Generate each secret with:  openssl rand -hex 32   (all different from one another)

NODE_ENV=production

# — MongoDB Atlas: connection string with the database name, e.g. mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nova?retryWrites=true&w=majority
MONGO_URL=

# — Secrets (min 32 chars, REQUIRED in production, must differ from each other)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
CRON_SECRET=
# the same value as the site project's REVALIDATE_SECRET
REVALIDATE_SECRET=

# — The final address of the SITE (not the API). Must match the real origin exactly: it is also the
#   first origin allowed to make signed-in writes (CSRF). Example: https://amirali-nova.vercel.app
WEB_APP_URL=
# Other origins that serve the same site (comma-separated), e.g. a www twin. Usually empty.
ALLOWED_ORIGINS=

COOKIE_SECURE=true

# — Email (Resend). Needs a verified domain of yours, or mail only reaches the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=

# — Images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# — Shared rate limits across instances (Upstash, optional but recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# — Optional
SENTRY_DSN=
LOG_LEVEL=info

# NEVER set RATE_LIMIT_DISABLED in production.
