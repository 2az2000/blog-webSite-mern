# Production values for the SITE project on Vercel. A checklist, not a place for secrets:
# set the real values in Vercel → Project → Settings → Environment Variables (Production).

# The API project's address, no trailing slash. Read at BUILD time: changing it means redeploying the site.
# The API must be up before the first build (pages are built from it).
API_ORIGIN=

# The final address of this site, no trailing slash (metadata, sitemap, feeds, link previews).
SITE_URL=

# The same value as the API project's REVALIDATE_SECRET (lets publishing refresh pages at once).
REVALIDATE_SECRET=
